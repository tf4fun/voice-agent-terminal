# Copy to .env.local and start the binary from this directory, or pass -env PATH.
# Values are literal. Existing process environment variables take precedence.
VOICE_ADDR=:8080
VOICE_DATA_DIR=./data
VOICE_MDNS=true
VOICE_MDNS_NAME=VoiceAgent
VOICE_MDNS_INTERFACE=
# Optional bearer token for device-to-gateway requests.
VOICE_API_KEY=
VOICE_CHAT_WORKERS=2

HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

VOICE_ASR_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription

# Offline transcription testing uses VOICE_ASR_PROVIDER=fake.
# Missing upstream keys are reported by /api/v1/server as disabled capabilities.
