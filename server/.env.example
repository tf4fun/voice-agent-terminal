# Copy to .env.local and start the binary from this directory, or pass -env PATH.
# Values are literal. Existing process environment variables take precedence.
VOICE_ADDR=:8080
VOICE_DATA_DIR=./data
VOICE_MDNS=true
VOICE_MDNS_NAME=VoiceAgent
VOICE_MDNS_INTERFACE=
# Optional bearer token for device-to-gateway requests.
VOICE_API_KEY=
VOICE_CHAT_WORKERS=2

HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Leads every chat request; empty keeps the built-in prompt for short replies.
HERMES_SYSTEM_PROMPT=

VOICE_ASR_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription

# Spoken replies: openai (uses OPENAI_API_KEY), fake (a chime) or off.
VOICE_TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
OPENAI_TTS_VOICE=marin
OPENAI_TTS_URL=wss://api.openai.com/v1/realtime
# Shapes reply speech for the device speaker: high-pass cutoff (0..1000 Hz,
# 0 is off), gain (-20..20 dB) and limiter ceiling (-40..0 dBFS).
VOICE_SPEECH_HIGHPASS_HZ=200
VOICE_SPEECH_GAIN_DB=0
VOICE_SPEECH_CEILING_DB=-10

# Offline transcription testing uses VOICE_ASR_PROVIDER=fake.
# Missing upstream keys are reported by /api/v1/server as disabled capabilities.
